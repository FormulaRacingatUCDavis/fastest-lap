<!--
  Electric F1 car variant based on limebeer-2014-f1.xml
  Uses a single electric motor on the rear axle with a differential.

  To switch from combustion to electric:
    1. Add <powertrain_type>electric</powertrain_type> in <rear-axle>
    2. Replace <engine> and <boost> with <electric-motor> block
    3. Set maximum-torque [N.m] and maximum-power [kW]

  maximum-power: 800 kW is representative of a modern racing motor, roughly equivalent to F1
  maximum-torque: 3200 N.m at the axle (after gear reduction)
-->
<vehicle type="f1-3dof">
    <front-axle model="axle-car"> 
        <track units="m"> 1.46 </track>
        <inertia units="kg.m2"> 0.00 </inertia>
        <smooth_throttle_coeff> 1.0e-5 </smooth_throttle_coeff>
        <brakes>
            <max_torque units="N.m">5000.0</max_torque>
        </brakes>
    </front-axle>

    <rear-axle>
        <track units="m"> 1.46 </track>
        <inertia units="kg.m2"> 0.0 </inertia>
        <smooth_throttle_coeff> 1.0e-5 </smooth_throttle_coeff>
        <differential_stiffness units="N.m.s/rad"> 10.47 </differential_stiffness>
        <brakes>
            <max_torque units="N.m">5000.0</max_torque>
        </brakes>

        <!-- Electric powertrain configuration -->
        <powertrain_type>electric</powertrain_type>
        <electric-motor>
            <!-- Maximum continuous torque at the wheel axle [N.m] -->
            <maximum-torque units="N.m"> 3200.0 </maximum-torque>
            <!-- Maximum continuous power [kW] (F1 equivalent) -->
            <maximum-power units="kW"> 800.0 </maximum-power>
            <!-- Gear ratio between motor shaft and wheel axle (1.0 = direct drive) -->
            <gear-ratio> 1.0 </gear-ratio>
        </electric-motor>
    </rear-axle>

    <chassis>
        <mass units="kg"> 798.0 </mass>  <!-- heavier due to battery pack -->

        <inertia>
            <Ixx> 112.5 </Ixx>  <Ixy> 0.0 </Ixy> <Ixz> 0.0   </Ixz>
            <Iyx> 0.0 </Iyx>  <Iyy> 425.0 </Iyy> <Iyz> 0.0   </Iyz>
            <Izx> 0.0 </Izx>  <Izy> 0.0 </Izy> <Izz> 450.0 </Izz>
        </inertia>

        <aerodynamics>
            <rho units="kg/m3"> 1.2 </rho>
            <area units="m2"> 1.5 </area>
            <cd> 0.9 </cd>
            <cl> 3.0 </cl>
        </aerodynamics>

        <com units="m"> 
            <x> 0.0 </x>
            <y> 0.0 </y>
            <z> -0.3 </z> 
        </com>
        <front_axle units="m"> 
            <x>  1.8  </x> 
            <y>  0.0  </y> 
            <z> -0.33 </z> 
        </front_axle>
        <rear_axle units="m"> 
            <x> -1.6  </x> 
            <y>  0.0  </y> 
            <z> -0.33 </z> 
        </rear_axle>
        <pressure_center units="m"> 
            <x> -0.1 </x> 
            <y>  0.0 </y> 
            <z> -0.3 </z>
        </pressure_center>
        <brake_bias> 0.6 </brake_bias>
        <roll_balance_coefficient> 0.5 </roll_balance_coefficient>
        <Fz_max_ref2> 1.0 </Fz_max_ref2>
    </chassis>

    <front-tire model="tire-pacejka-simple" type="normal">
        <radius units="m">0.330</radius> 
        <radial-stiffness>0.0</radial-stiffness>
        <radial-damping>0.0</radial-damping>
        <Fz-max-ref2> 1.0 </Fz-max-ref2>
        <reference-load-1 units="N"> 2000.0 </reference-load-1> 
        <reference-load-2 units="N"> 6000.0 </reference-load-2> 
        <mu-x-max-1> 1.75 </mu-x-max-1>
        <mu-x-max-2> 1.40 </mu-x-max-2>
        <kappa-max-1> 0.11 </kappa-max-1>
        <kappa-max-2> 0.10 </kappa-max-2>
        <mu-y-max-1> 1.80 </mu-y-max-1>
        <mu-y-max-2> 1.45 </mu-y-max-2>
        <lambda-max-1 units="deg"> 9.0 </lambda-max-1>
        <lambda-max-2 units="deg"> 8.0 </lambda-max-2>
        <Qx> 1.9 </Qx>
        <Qy> 1.9 </Qy>
    </front-tire>

    <rear-tire model="tire-pacejka-simple" type="normal">
        <radius units="m">0.330</radius> 
        <radial-stiffness>0.0</radial-stiffness>
        <radial-damping>0.0</radial-damping>
        <Fz-max-ref2> 1.0 </Fz-max-ref2>
        <reference-load-1 units="N"> 2000.0 </reference-load-1> 
        <reference-load-2 units="N"> 6000.0 </reference-load-2> 
        <mu-x-max-1> 1.75 </mu-x-max-1>
        <mu-x-max-2> 1.40 </mu-x-max-2>
        <kappa-max-1> 0.11 </kappa-max-1>
        <kappa-max-2> 0.10 </kappa-max-2>
        <mu-y-max-1> 1.80 </mu-y-max-1>
        <mu-y-max-2> 1.45 </mu-y-max-2>
        <lambda-max-1 units="deg"> 9.0 </lambda-max-1>
        <lambda-max-2 units="deg"> 8.0 </lambda-max-2>
        <Qx> 1.9 </Qx>
        <Qy> 1.9 </Qy>
    </rear-tire>
</vehicle>
